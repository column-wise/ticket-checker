<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 인터파크/멜론 도메인은 HTTP 이미지 리소스를 사용하므로 cleartext 허용 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">interpark.com</domain>
        <domain includeSubdomains="true">melon.com</domain>
        <domain includeSubdomains="true">kakao.com</domain>
    </domain-config>
    <!-- 그 외 모든 도메인은 HTTPS만 허용 -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
