# ── 공통 ──────────────────────────────────────────────────────────────────────

slack_webhook_url = "https://hooks.slack.com/services/XXX/YYY/ZZZ"

# ── 인터파크 ──────────────────────────────────────────────────────────────────

checker_script = "interpark_checker.py"

# 인터파크 예매 페이지 Network 탭 > BookInfoXml.asp?Flag=OrderSeatGrade > SessionId 파라미터
interpark_session_id = "26006903_M..."

# 브라우저 쿠키 (poticket.interpark.com / .interpark.com)
interpark_cookies_pcid           = ""
interpark_cookies_interparkstamp = ""
interpark_cookies_eccs           = ""
interpark_cookies_captgm         = ""
interpark_cookies_ent_token      = ""

